# Meta app → Instagram → API setup with Instagram login
IG_APP_SECRET=replace-with-app-secret
IG_VERIFY_TOKEN=any-random-string-you-also-paste-into-meta
IG_ACCESS_TOKEN=            # long-lived token for the @stash account; leave empty for dry-run
IG_USERNAME=stash           # used for the ig.me/m/<username> link on the invite page
GRAPH_VERSION=v21.0

ADMIN_TOKEN=change-me-long-random          # 24+ random chars; empty turns the admin panel off
SECRET_KEY=change-me-another-long-random   # 32+ random chars; signs welcome-page links
# Generate strong values with: python scripts/make_secrets.py
PUBLIC_BASE_URL=http://localhost:8000
DB_PATH=stash.db
WORKER_ENABLED=1
APP_ENV=development        # "production" refuses weak secrets and sends HSTS
RATE_LIMITS=1
TRUST_PROXY=0              # 1 when behind your host's proxy, so limits are per visitor
# Reminders. Empty = dry run (logged, not sent).
VAPID_PUBLIC_KEY=          # from scripts/make_secrets.py
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Stash <reminders@example.com>
