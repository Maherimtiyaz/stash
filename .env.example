# Meta app → Instagram → API setup with Instagram login
IG_APP_SECRET=replace-with-app-secret
IG_VERIFY_TOKEN=any-random-string-you-also-paste-into-meta
IG_ACCESS_TOKEN=            # long-lived token for the @stash account; leave empty for dry-run
IG_USERNAME=stash           # used for the ig.me/m/<username> link on the invite page
GRAPH_VERSION=v21.0

ADMIN_TOKEN=change-me-long-random
SECRET_KEY=change-me-another-long-random   # signs welcome/library links
PUBLIC_BASE_URL=http://localhost:8000
DB_PATH=stash.db
WORKER_ENABLED=1
